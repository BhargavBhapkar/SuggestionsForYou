PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/suggestionsforyou?retryWrites=true&w=majority
JWT_SECRET=change-this-to-a-long-random-string
CORS_ORIGIN=http://localhost:5173
RAPIDAPI_KEY=your-rapidapi-key-for-real-time-amazon-data
# Image search for product photos (https://serper.dev) - used by `npm run fetch:images`
SERPER_API_KEY=your-serper-dev-key
ANTHROPIC_API_KEY=your-anthropic-api-key-for-the-ai-chat-widget

# Razorpay online payments (https://dashboard.razorpay.com). Leave blank to offer cash on delivery only.
# Use the rzp_test_ key pair while testing; the webhook secret is set when you create the webhook
# (URL: <api>/api/payments/webhook, events: payment.captured / order.paid).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Contact form: messages are always saved to the database. To also get each one in your inbox, fill in the
# SMTP login of the mailbox you send from (for Hostinger email: smtp.hostinger.com, port 465).
# CONTACT_INBOX defaults to support@suggestionsforyou.com.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# CONTACT_INBOX=support@suggestionsforyou.com

# Optional: override the DNS servers Node uses (needed if mongodb+srv lookups fail with ECONNREFUSED)
# DNS_SERVERS=8.8.8.8,1.1.1.1
